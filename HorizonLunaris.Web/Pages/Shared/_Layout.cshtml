@{
    // Razor Pages route value, e.g. "/Index", "/UserRoles/Index"
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Active(string prefix) =>
        page.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "nav-btn active" : "nav-btn";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Horizon Lunaris</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">

        <!-- Left Navigation Panel -->
        <nav class="sidebar">
            <div class="app-title">Horizon Lunaris</div>

            @await Component.InvokeAsync("UserPicker")

            <a class="@(page == "/Index" ? "nav-btn active" : "nav-btn")" asp-page="/Index">Dashboard</a>
            <a class="@Active("/Tasks")" asp-page="/Tasks/Index">Task Management</a>
            <a class="@Active("/Automations")" asp-page="/Automations/Index">Automations</a>
            <a class="@Active("/UserRoles")" asp-page="/UserRoles/Index">User Roles</a>
        </nav>

        <!-- Main Content Area -->
        <main class="content">
            @RenderBody()
        </main>

    </div>
</body>
</html>
