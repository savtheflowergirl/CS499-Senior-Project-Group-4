<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Horizon Lunaris</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 0; color: #1f2933; background: #f5f7fa; }
        header { background: #1f2933; color: #fff; padding: 0.75rem 1.5rem; }
        header a { color: #fff; text-decoration: none; font-weight: 600; }
        main { max-width: 56rem; margin: 1.5rem auto; padding: 0 1rem; }
        .card { background: #fff; border: 1px solid #d9e2ec; border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
        .error { background: #fde8e8; border-color: #f5b5b5; }
        select, button { font: inherit; padding: 0.3rem 0.6rem; }
    </style>
</head>
<body>
    <header><a href="/">Horizon Lunaris</a></header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
