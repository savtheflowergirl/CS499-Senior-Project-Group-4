
@page
@model HorizonLunaris.Web.Pages.ProjectsModel
@{
    ViewData["Title"] = "Projects & Tasks";
}

<h1>Projects & Tasks</h1>
<p><a asp-page="/Index">Back to Home</a></p>
@if (Model.Error != null)
{
    <div class="card error">
        @Model.Error
    </div>
}
<!-- create a new project -->
<div class="card">
    <h2>Create Project</h2>
    <form method="post" asp-page-handler="CreateProject">
        <p>
            <label for="projectName">Project Name</label>
            <input id="projectName" type="text" name="name" required />
        </p>
        <p>
            <label for="projectDescription">Description</label>
            <input id="projectDescription" type="text" name="description" />
        </p>
        <button type="submit">Create Project</button>
    </form>
</div>
<!-- display all projects -->
<div class="card">
    <h2>Your Projects</h2>
    @if (Model.Projects.Count == 0)
    {
        <p>No projects have been created yet.</p>
    }
    else
    {
        @foreach (var project in Model.Projects)
        {
            <p>
                <a asp-page="/Projects"
                   asp-route-projectId="@project.Id">
                    @project.Name
                </a>
                - @project.Description
            </p>
        }
    }
</div>
@if (Model.SelectedProjectId.HasValue)
{
    <!-- create task or subtask -->
    <div class="card">
        <h2>Add Task</h2>
        <form method="post" asp-page-handler="CreateTask">
            <input type="hidden"
                   name="projectId"
                   value="@Model.SelectedProjectId" />
            <p>
                <label for="taskTitle">Task Title</label>
                <input id="taskTitle" type="text" name="title" required />
            </p>
            <p>
                <label for="taskDescription">Description</label>
                <input id="taskDescription" type="text" name="description" />
            </p>
            <p>
                <label for="parentTask">Parent Task (optional)</label>
                <select id="parentTask" name="parentTaskId">
                    <option value="">None - Main Task</option>

                    @foreach (var task in Model.Tasks)
                    {
                        <option value="@task.Id">@task.Title</option>
                    }
                </select>
            </p>
            <div class="assignee-picker">
                <label>Assignees (optional)</label>
                <input type="search" class="assignee-search" placeholder="Search team members" aria-label="Search team members" />
                <div class="assignee-list">
                    @foreach (var user in Model.Users)
                    {
                        <label class="assignee-option" data-search="@user.Name @user.Email">
                            <input type="checkbox" name="assigneeIds" value="@user.Id" />
                            <span>@user.Name</span>
                        </label>
                    }
                </div>
            </div>
            <button type="submit">Create Task</button>
        </form>
    </div>
    <!-- display sleected project task -->
    <div class="card">
        <h2>Project Tasks</h2>
        @if (Model.Tasks.Count == 0)
        {
            <p>No tasks have been added yet.</p>
        }
        else
        {
            @foreach (var task in Model.Tasks)
            {
                <div class="card"
                     style="margin-left: @(task.ParentTaskId.HasValue ? "30px" : "0");">

                    <h3>
                        @if (task.ParentTaskId.HasValue)
                        {
                            <span>↳ Subtask: </span>
                        }
                        @task.Title
                    </h3>
                    <p>@task.Description</p>
                    <p>Status: @task.Status</p>
                    @if (task.DueDateUtc is { } dueDate)
                    {
                        <a class="btn small calendar-link" href="@GoogleCalendarLink.Create(task.Title, dueDate)" target="_blank" rel="noopener noreferrer">Add to Google Calendar</a>
                    }

                    <!-- update task status -->
                    <form method="post" asp-page-handler="UpdateStatus">
                        <input type="hidden"
                               name="projectId"
                               value="@Model.SelectedProjectId" />
                        <input type="hidden"
                               name="taskId"
                               value="@task.Id" />

                        <label for="status-@task.Id">Change Status</label>
                        <select id="status-@task.Id" name="status">
                            <option value="1" selected="@(task.Status == HorizonLunaris.Domain.Enums.TaskItemStatus.Available)">
                                Available
                            </option>
                            <option value="2" selected="@(task.Status == HorizonLunaris.Domain.Enums.TaskItemStatus.InProgress)">
                                In Progress
                            </option>
                            <option value="3" selected="@(task.Status == HorizonLunaris.Domain.Enums.TaskItemStatus.Completed)">
                                Completed
                            </option>
                        </select>

                        <button type="submit">Update Status</button>
                    </form>

                    <p>Assigned to: @(task.Assignees.Count == 0 ? "Unassigned" : string.Join(", ", task.Assignees.Select(assignee => assignee.Name)))</p>

                    <form method="post" asp-page-handler="AddComment">
                        <input type="hidden" name="projectId"
                               value="@Model.SelectedProjectId" />
                        <input type="hidden" name="taskId"
                               value="@task.Id" />

                        <p>
                            <label for="comment-@task.Id">Add Comment</label>
                            <textarea id="comment-@task.Id"
                                      name="text"
                                      maxlength="2000"
                                      required></textarea>
                        </p>

                        <button type="submit">Post Comment</button>
                    </form>

                    @if (Model.TaskComments.TryGetValue(task.Id, out var comments))
                    {
                        foreach (var comment in comments)
                        {
                            <p>
                                <strong>@comment.AuthorName</strong>
                                (@comment.CreatedAtUtc.ToLocalTime().ToString("g")):
                                @comment.Text
                            </p>
                        }
                    }

                    <form method="post" asp-page-handler="AssignAssignees">
                        <input type="hidden" name="projectId" value="@Model.SelectedProjectId" />
                        <input type="hidden" name="taskId" value="@task.Id" />
                        <div class="assignee-picker">
                            <label>Assignees</label>
                            <input type="search" class="assignee-search" placeholder="Search team members" aria-label="Search team members" />
                            <div class="assignee-list">
                                @foreach (var user in Model.Users)
                                {
                                    <label class="assignee-option" data-search="@user.Name @user.Email">
                                        <input type="checkbox" name="assigneeIds" value="@user.Id" checked="@(task.Assignees.Any(assignee => assignee.Id == user.Id))" />
                                        <span>@user.Name</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <button type="submit">Save Assignees</button>
                    </form>
                </div>
            }
        }
    </div>
}

<script>
    document.querySelectorAll(".assignee-picker").forEach(picker => {
        const search = picker.querySelector(".assignee-search");
        const options = [...picker.querySelectorAll(".assignee-option")];
        const filterOptions = () => {
            const query = search.value.trim().toLocaleLowerCase();
            options.forEach(option => {
                const selected = option.querySelector("input").checked;
                option.hidden = !selected && !option.dataset.search.toLocaleLowerCase().includes(query);
            });
        };
        search.addEventListener("input", filterOptions);
        picker.addEventListener("change", filterOptions);
        filterOptions();
    });
</script>
