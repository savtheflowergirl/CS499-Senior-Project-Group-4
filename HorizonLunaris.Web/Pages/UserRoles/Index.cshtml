@page
@model HorizonLunaris.Web.Pages.UserRoles.IndexModel
@{
    ViewData["Title"] = "User Roles";
}

<!-- Top Header Banner -->
<div class="header-banner">USER ROLES and Team Management</div>

@if (Model.ErrorMessage is not null)
{
    <div class="card error">@Model.ErrorMessage</div>
}
@if (Model.Message is not null)
{
    <div class="card success">@Model.Message</div>
}

<!-- Main Content Split -->
<div class="split">

    <!-- LEFT PANEL: Team Members List -->
    <section class="panel">
        <h2 class="panel-title">Team members</h2>

        <form method="get" class="toolbar">
            <div class="search-bar">
                <span class="search-icon">🔍</span>
                <input type="text" name="Search" value="@Model.Search" placeholder="Search team members" />
            </div>
            <button type="submit" class="tool-btn">Search</button>
        </form>

        @if (Model.IsAdmin)
        {
            <form method="post" asp-page-handler="CreateUser" class="user-create-form">
                <h3>Add user</h3>
                <label for="NewName">Name</label>
                <input id="NewName" name="NewName" maxlength="100" required />
                <label for="NewEmail">Email</label>
                <input id="NewEmail" name="NewEmail" type="email" maxlength="200" required />
                <label for="NewRole">Role</label>
                <select id="NewRole" name="NewRole">
                    <option value="TeamMember">Team Member</option>
                    <option value="ProjectManager">Project Manager</option>
                    <option value="Admin">Admin</option>
                </select>
                <button type="submit" class="btn">Add user</button>
            </form>
        }

        <!-- Table Column Headers -->
        <div class="table-row table-head">
            <div>User</div>
            <div>Email</div>
            <div>Role</div>
            <div>Active Tasks</div>
        </div>

        <!-- Member Rows -->
        @if (Model.Members.Count == 0 && Model.ErrorMessage is null)
        {
            <div class="row-card empty">No team members found.</div>
        }
        else
        {
            @foreach (var m in Model.Members)
            {
                <div class="row-card table-row">
                    <div>@m.Name@(m.Id == Model.CurrentUserId ? " (you)" : "")</div>
                    <div>
                        @if (Model.IsAdmin)
                        {
                            <form method="post" asp-page-handler="UpdateEmail" class="user-email-form">
                                <input type="hidden" name="userId" value="@m.Id" />
                                <input type="email" name="email" value="@m.Email" maxlength="200" required aria-label="Email for @m.Name" />
                                <button type="submit" class="btn small">Save</button>
                            </form>
                        }
                        else
                        {
                            @m.Email
                        }
                    </div>
                    <div>@m.Role</div>
                    <div>@(m.ActiveTasks?.ToString() ?? "\u2014")</div>
                </div>
            }
        }
    </section>

    <!-- RIGHT PANEL: Role Settings -->
    <aside class="panel">
        <h2 class="panel-title">Role Settings</h2>
        <!-- Settings toggles and matrices will go here -->
    </aside>

</div>
