
@model Horizon_Lunaris_UI.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Horizon Lunaris</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #101426, #222b49);
            font-family: Arial, sans-serif;
            color: white;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 40px;
            margin: 20px;
            border-radius: 16px;
            background: #202841;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
        }

        h1 {
            text-align: center;
            margin-bottom: 8px;
            color: #aabaff;
        }

        .subtitle {
            text-align: center;
            color: #a8afc8;
            margin-bottom: 30px;
        }

        label {
            display: block;
            margin-bottom: 8px;
        }

        input {
            width: 100%;
            padding: 12px;
            margin-bottom: 20px;
            background: #12182b;
            border: 1px solid #414c6d;
            border-radius: 8px;
            color: white;
        }

        input:focus {
            outline: 2px solid #879cff;
        }

        button {
            width: 100%;
            padding: 13px;
            background: #798cff;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            color: #101426;
        }

        button:hover {
            background: #a0aeff;
        }

        .error {
            color: #ff9b9b;
            margin-bottom: 15px;
        }
    </style>
</head>

<body>
    <div class="login-container">
        <h1>Horizon Lunaris</h1>
        <p class="subtitle">Project Management System</p>

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="error"></div>

            <label asp-for="Email">Email Address</label>
            <input asp-for="Email"
                   type="email"
                   autocomplete="username"
                   required />

            <label asp-for="Password">Password</label>
            <input asp-for="Password"
                   type="password"
                   autocomplete="current-password"
                   required />

            <button type="submit">Sign In</button>
        </form>
    </div>
</body>
</html>
