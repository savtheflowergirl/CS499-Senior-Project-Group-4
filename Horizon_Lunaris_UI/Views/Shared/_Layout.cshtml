
@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";

    string Active(string controller) =>
        string.Equals(current, controller, StringComparison.OrdinalIgnoreCase)
            ? "nav-btn active"
            : "nav-btn";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Horizon Lunaris</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">

        <!-- Left Navigation Panel -->
        <nav class="sidebar">
            <div class="app-title">Horizon Lunaris</div>

            <a class="@Active("Home")"
               asp-controller="Home"
               asp-action="Index">
                Dashboard
            </a>

            <a class="@Active("Tasks")"
               asp-controller="Tasks"
               asp-action="Index">
                Task Management
            </a>

            <a class="@Active("Automations")"
               asp-controller="Automations"
               asp-action="Index">
                Automations
            </a>

            <a class="@Active("UserRoles")"
               asp-controller="UserRoles"
               asp-action="Index">
                User Roles
            </a>

            <!-- Logout Button -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      style="margin-top: 20px;">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="nav-btn"
                            style="width: 100%; text-align: left; cursor: pointer;">
                        Log Out
                    </button>
                </form>
            }
        </nav>

        <!-- Main Content Area -->
        <main class="content">
            @RenderBody()
        </main>

    </div>
</body>
</html>
