<Window x:Class="Horizon_Lunaris_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Horizon_Lunaris_UI"
        mc:Ignorable="d"
        Title="Horizon Lunaris" Height="720" Width="1280">

    <Grid Background="#1E232E">
        <Grid.ColumnDefinitions>
            <!-- Left Navigation Menu -->
            <ColumnDefinition Width="275"/>

            <!-- Main Content Area (Takes remaining space) -->
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel (UI) -->
        <Border Grid.Column="0" Background="#151A22" Padding="20">
            <StackPanel>

                <!-- App Title / Logo Area -->
                <TextBlock Text="Horizon Lunaris" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,10,0,40"/>

                <!-- Navigation Buttons -->
                <Button x:Name="BtnDashboard" Content="Dashboard" Height="45" Margin="0,0,0,10" 
                        Background="#2A3143" Foreground="White" BorderThickness="0" FontSize="14"/>

                <Button x:Name="BtnTaskManagement" Content="Task Management" Height="45" Margin="0,0,0,10" 
                        Background="Transparent" Foreground="LightGray" BorderThickness="0" FontSize="14"/>

                <Button x:Name="BtnAutomations" Content="Automations" Height="45" Margin="0,0,0,10" 
                        Background="Transparent" Foreground="LightGray" BorderThickness="0" FontSize="14"/>

                <Button x:Name="BtnUserRoles" Content="User Roles" Click="BtnUserRoles_Click" Height="45" Margin="0,0,0,10" Background="Transparent" Foreground="LightGray" BorderThickness="0" FontSize="14"/>

            </StackPanel>
        </Border>

        <!-- Main Content Frame (This is where C# will load your different screens) -->
        <Frame x:Name="MainContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>

        <!-- Menu and Content will go here -->

    </Grid>
</Window>