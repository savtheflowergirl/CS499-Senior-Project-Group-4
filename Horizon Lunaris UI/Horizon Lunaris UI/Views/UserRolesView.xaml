<UserControl x:Class="Horizon_Lunaris_UI.Views.UserRolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Horizon_Lunaris_UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  
        <Grid Background="#1E232E" Margin="20">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Main Two-Panel Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Banner -->
            <Border Grid.Row="0" Background="#B0B8C1" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                <TextBlock Text="USER ROLES and Team Management" Foreground="#1E232E" FontSize="18" HorizontalAlignment="Center"/>
            </Border>

            <!-- Main Content Split -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left column takes up proportionally more space (about 75%) -->
                    <ColumnDefinition Width="7.5*"/>
                    <!-- Spacer column -->
                    <ColumnDefinition Width="20"/>
                    <!-- Right column (about 25%) -->
                    <ColumnDefinition Width="2.5*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: Team Members List -->
                <Border Grid.Column="0" Background="#CFD4DA" CornerRadius="15" Padding="20">
                    <StackPanel>

                        <!-- Panel Title -->
                        <TextBlock Text="Team members" Foreground="#1E232E" FontSize="16" Margin="0,0,0,15"/>

                        <!-- Toolbar: Search, Roles Dropdown, Invite Button -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <!-- Search bar stretches to fill space -->
                                <ColumnDefinition Width="15"/>
                                <!-- Spacer -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Roles button sizing -->
                                <ColumnDefinition Width="15"/>
                                <!-- Spacer -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Invite button sizing -->
                            </Grid.ColumnDefinitions>

                            <!-- Search Bar -->
                            <Border Grid.Column="0" Background="#8B919A" CornerRadius="8" Padding="10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" Foreground="#4A5056" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox Text="Search team members" Foreground="#333" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Width="300"/>
                                </StackPanel>
                            </Border>

                            <!-- Roles Button/Dropdown -->
                            <Button Grid.Column="2" Content="Roles" Background="#8B919A" Foreground="#1E232E" BorderThickness="0" Padding="20,10" Width="100">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Invite Member Button -->
                            <Button Grid.Column="4" Content="+ Invite member" Background="#8B919A" Foreground="#1E232E" BorderThickness="0" Padding="20,10" Width="130">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Table Column Headers -->
                        <Grid Margin="10,0,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="User" Foreground="#1E232E" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="Email" Foreground="#1E232E" FontSize="14"/>
                            <TextBlock Grid.Column="2" Text="Role" Foreground="#1E232E" FontSize="14"/>
                            <TextBlock Grid.Column="3" Text="Active Tasks" Foreground="#1E232E" FontSize="14"/>
                            <TextBlock Grid.Column="4" Text="Actions" Foreground="#1E232E" FontSize="14"/>
                        </Grid>

                        <!-- Dummy Row Placeholders -->
                        <Border Background="#8B919A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <TextBlock Text="Search team members" Foreground="#333" HorizontalAlignment="Center"/>
                        </Border>

                        <Border Background="#8B919A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <TextBlock Text="Search team members" Foreground="#333" HorizontalAlignment="Center"/>
                        </Border>

                        <Border Background="#8B919A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <TextBlock Text="Search team members" Foreground="#333" HorizontalAlignment="Center"/>
                        </Border>

                        <Border Background="#8B919A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <TextBlock Text="Search team members" Foreground="#333" HorizontalAlignment="Center"/>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- RIGHT PANEL: Role Settings -->
                <Border Grid.Column="2" Background="#CFD4DA" CornerRadius="15" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Role Settings" Foreground="#1E232E" FontSize="16" Margin="0,0,0,15"/>
                        <!-- Settings toggles and matrices will go here -->
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
</UserControl>
